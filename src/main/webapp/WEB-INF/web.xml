<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">
 
    <display-name>Polleria El Dorado</display-name>
 
    <!-- Servlet: Home -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.polleria.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
 
    <!-- Servlet: Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.polleria.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
 
    <!-- Servlet: Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.polleria.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
 
    <!-- Servlet: Categoria -->
    <servlet>
        <servlet-name>CategoriaServlet</servlet-name>
        <servlet-class>com.polleria.servlet.CategoriaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoriaServlet</servlet-name>
        <url-pattern>/categoria</url-pattern>
    </servlet-mapping>
 
    <!-- Servlet: Producto -->
    <servlet>
        <servlet-name>ProductoServlet</servlet-name>
        <servlet-class>com.polleria.servlet.ProductoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductoServlet</servlet-name>
        <url-pattern>/producto</url-pattern>
    </servlet-mapping>
 
    <!-- Servlet: Admin Usuarios -->
    <servlet>
        <servlet-name>AdminUsuarioServlet</servlet-name>
        <servlet-class>com.polleria.servlet.admin.AdminUsuarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUsuarioServlet</servlet-name>
        <url-pattern>/admin/usuarios</url-pattern>
    </servlet-mapping>
 
    <!-- Servlet: Admin Roles -->
    <servlet>
        <servlet-name>AdminRolServlet</servlet-name>
        <servlet-class>com.polleria.servlet.admin.AdminRolServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminRolServlet</servlet-name>
        <url-pattern>/admin/roles</url-pattern>
    </servlet-mapping>
 
    <!-- Página de inicio por defecto -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
 
    <!-- Página de error 404 -->
    <error-page>
        <error-code>404</error-code>
        <location>/vista/error.jsp</location>
    </error-page>

    <!-- Servlet: Promociones -->
    <servlet>
        <servlet-name>PromocionesServlet</servlet-name>
        <servlet-class>com.polleria.servlet.PromocionesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PromocionesServlet</servlet-name>
        <url-pattern>/promociones</url-pattern>
    </servlet-mapping>
 
    
    <servlet>
        <servlet-name>PromocionDetalleServlet</servlet-name>
        <servlet-class>com.polleria.servlet.PromocionDetalleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PromocionDetalleServlet</servlet-name>
        <url-pattern>/promocion</url-pattern>
    </servlet-mapping>

    <servlet>
    <servlet-name>AdminProductoServlet</servlet-name>
    <servlet-class>com.polleria.servlet.admin.AdminProductoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminProductoServlet</servlet-name>
        <url-pattern>/admin/productos</url-pattern>
    </servlet-mapping>

    <servlet>
    <servlet-name>CarritoServlet</servlet-name>
    <servlet-class>com.polleria.servlet.CarritoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CarritoServlet</servlet-name>
        <url-pattern>/carrito</url-pattern>
    </servlet-mapping>

    <servlet>
    <servlet-name>LibroReclamacionServlet</servlet-name>
    <servlet-class>com.polleria.servlet.LibroReclamacionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LibroReclamacionServlet</servlet-name>
        <url-pattern>/libro-reclamaciones</url-pattern>
    </servlet-mapping>

    <!-- Servlet: AdminReclamaciones -->
    <servlet>
        <servlet-name>AdminReclamacionServlet</servlet-name>
        <servlet-class>com.polleria.servlet.admin.AdminReclamacionServlet</servlet-class>
        </servlet>
        <servlet-mapping>
        <servlet-name>AdminReclamacionServlet</servlet-name>
        <url-pattern>/admin/reclamaciones</url-pattern>
    </servlet-mapping>

    <servlet>
    <servlet-name>CheckoutServlet</servlet-name>
    <servlet-class>com.polleria.servlet.CheckoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckoutServlet</servlet-name>
        <url-pattern>/checkout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ConfirmacionServlet</servlet-name>
        <servlet-class>com.polleria.servlet.ConfirmacionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfirmacionServlet</servlet-name>
        <url-pattern>/confirmacion</url-pattern>
    </servlet-mapping>

</web-app>